# JobHunter Pro - Environment configuration
# Copy this file to .env and customize.

# ---------- Application ----------
APP_NAME=HireFlow AI
APP_VENDOR=Etwin Technology
APP_VERSION=1.2.1
APP_ENV=production
DEBUG=false

# ---------- Database ----------
DATABASE_URL=sqlite:///data/jobhunter.db
DATABASE_ECHO=false

# ---------- Scraping ----------
SCRAPER_HEADLESS=true
SCRAPER_MAX_PAGES=5
SCRAPER_RETRY_COUNT=3
SCRAPER_TIMEOUT=30
SCRAPER_MIN_DELAY=1.5
SCRAPER_MAX_DELAY=4.0
SCRAPER_CONCURRENT_LIMIT=3
SCRAPER_USER_AGENT_ROTATE=true

# ---------- Proxy (optional) ----------
PROXY_ENABLED=false
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=

# ---------- Export ----------
EXPORT_DIR=exports
EXPORT_DEFAULT_FORMAT=xlsx
EXPORT_AUTO_OPEN=false

# ---------- Scheduler ----------
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=120
SCHEDULER_DAILY_TIME=08:00
SCHEDULER_RUN_ON_STARTUP=false

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=app.log
LOG_ROTATION=10 MB
LOG_RETENTION=14 days

# ---------- API ----------
API_HOST=127.0.0.1
API_PORT=8765
API_ENABLED=false

# ---------- Security ----------
SECRET_KEY=change-me-to-a-long-random-string
ENCRYPTION_SALT=jobhunter-default-salt

# ---------- Notifications ----------
NOTIFICATIONS_ENABLED=true
NOTIFY_ON_COMPLETE=true
NOTIFY_ON_ERROR=true

# ---------- GUI ----------
GUI_THEME=dark
GUI_COLOR_THEME=blue
GUI_SCALING=1.0
